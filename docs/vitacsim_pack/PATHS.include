source/ViTacLab/ViTacLab/assets/sensor/__init__.py
source/ViTacLab/ViTacLab/assets/sensor/shadow_hand_tacsl.py
source/ViTacLab/ViTacLab/assets/sensor/shadow_hand_full_tactile/

# --- Robot integration (UR10e + ShadowHand tactile) ---
source/ViTacLab/ViTacLab/assets/robot/

# --- Task glue: Forge + pretraining (GelSight finger calibration tasks) ---
source/ViTacLab/ViTacLab/tasks/direct/simple_gripper/
source/ViTacLab/ViTacLab/tasks/direct/medium_dexhand/forge_dexhand/
source/ViTacLab/ViTacLab/tasks/direct/pretraining/
source/ViTacLab/ViTacLab/tasks/direct/__init__.py
source/ViTacLab/ViTacLab/tasks/__init__.py
source/ViTacLab/ViTacLab/__init__.py

# --- Local USD / meshes (exclude Scene/ and Objects/ — see README) ---
source/ViTacLab/ViTacLab/assets/data/Sensors/
source/ViTacLab/ViTacLab/assets/data/Robots/ShadowHand/
