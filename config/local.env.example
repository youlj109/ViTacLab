# Copy to config/local.env and replace values for the local machine.
# Never commit tokens or credentials to this file.

export VITACLAB_ROOT="/path/to/ViTacLab"
export ISAACLAB_ROOT="/path/to/IsaacLab"
export ISAACLAB_SH="${ISAACLAB_ROOT}/isaaclab.sh"
export CONDA_ENV="<isaac-lab-environment>"
export DEVICE="cuda:0"

# Created by bash_command/upload_hf_assets.sh.
export VITACLAB_HF_REPO="Yanlj/ViTacLab-assets"

# Optional calibration inputs.
export TAXIM_REPO="${VITACLAB_ROOT}/third_party/Taxim"
export REAL_ROOT="${VITACLAB_ROOT}/data/calibration/tactile/real"
export SIM_ROOT="${VITACLAB_ROOT}/logs/vitacsim_calibration/sweep"
export FITTED_PARAMS="${VITACLAB_ROOT}/data/calibration/tactile/fitted_params.json"

# Optional output locations.
export RECORD_DIR="${VITACLAB_ROOT}/logs/demo_records"
export VIDEO_DIR="${VITACLAB_ROOT}/logs/demo_videos"
